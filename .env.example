# Founder OS environment template. Copy to .env.local and fill in. NEVER commit .env.local.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and must never be exposed to the browser.
# Phases show when each variable is first needed; leave later ones empty until then.
# An empty value means the feature reports "not configured". It will not pretend to work.

# --- Phase 1 -----------------------------------------------------------------
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The public ("anon") key. Safe in the browser only because Row Level Security is on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the app is served; used for sign-in redirects. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google sign-in: client ID/secret are configured in the Supabase dashboard (Auth > Providers),
# not here.

# --- Phase 4 (AI assistant) --------------------------------------------------
# Google AI Studio API key. SERVER ONLY.
GEMINI_API_KEY=
# Kept configurable because model names and free-tier availability change.
GEMINI_MODEL=
# Your own daily cap on assistant requests, so you hit your limit before Google's.
AI_DAILY_REQUEST_CAP=100

# --- Phase 5 (reliability) ---------------------------------------------------
# Bypasses Row Level Security. SERVER ONLY. Used by the reminder scheduler and backup job.
SUPABASE_SERVICE_ROLE_KEY=
# Random string (e.g. `openssl rand -hex 32`) protecting /api/cron/* endpoints.
CRON_SECRET=
# Web Push. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Voice assistant (Urdu) --------------------------------------------------
# Speech -> text uses GEMINI_API_KEY (above). Override the model if needed.
GEMINI_STT_MODEL=
# Text -> speech. "elevenlabs", "gemini" or "off". Empty = ElevenLabs if its key is set, else Gemini.
TTS_PROVIDER=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
# Optional, better quality, limited free characters per month. https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Fast free brain (recommended: Gemini's free allowance is small and slow) ----
# Free key, no card: https://console.groq.com . Also used for Whisper speech-to-text as a fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional second fast provider. Free key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
# Which brain goes first: "groq", "cerebras" or "gemini". Empty = fast providers first, Gemini as the fallback.
LLM_PROVIDER=
# Which speech-to-text goes first: "gemini" (default) or "groq".
STT_PROVIDER=

# Urdu turns use Gemini first (better Urdu), English turns use the fast provider. Set LLM_URDU_PROVIDER=fast to disable that,
# or LLM_PROVIDER=gemini|groq|cerebras to force one provider for everything.
# LLM_URDU_PROVIDER=

# Spoken replies, tried in this order: ElevenLabs (if the key is set) -> Gemini voice. Microsoft's free voice is off unless you set TTS_EDGE=on.
# ELEVENLABS_API_KEY=            # free key from elevenlabs.io; best Urdu quality; limited free monthly characters
# ELEVENLABS_VOICE_ID=           # optional; pick any voice from your ElevenLabs library
# TTS_EDGE=on                    # optional: add Microsoft's free voice as an extra fallback (unofficial; may stop working)
# EDGE_TTS_VOICE_UR=ur-PK-UzmaNeural   # or ur-PK-AsadNeural for a male voice

# Voice speed/quality (all optional). Urdu needs Eleven v3; English is fastest on Flash v2.5.
# ELEVENLABS_MODEL_UR=eleven_v3
# ELEVENLABS_MODEL_EN=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID_UR=cjVigY5qzO86Huf0OWal
# ELEVENLABS_VOICE_ID_EN=cjVigY5qzO86Huf0OWal
# ELEVENLABS_FORMAT=mp3_22050_32

# Telegram backup reminders (optional). Create a bot with @BotFather, paste its token here, redeploy, then Settings > Telegram > Connect.
# TELEGRAM_BOT_TOKEN=

# Email backup for reminders (optional, no VPN needed). Free key at resend.com; sign up with the SAME email as your Founder OS login
# (Resend's test sender only delivers to the account owner's own address).
# RESEND_API_KEY=
# REMINDER_EMAIL_TO=      (optional; defaults to your login email)
# REMINDER_EMAIL_FROM=    (optional; defaults to Resend's test sender)

# Google Calendar mirror (optional). Reminders you set and tasks with a due time become calendar events with pop-up alerts (Asia/Karachi).
# GOOGLE_CALENDAR_ID=                 the calendar's ID (Calendar settings > Integrate calendar), e.g. xxxx@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_JSON=        the whole service-account key file as ONE line of JSON (set in Vercel only, never commit it)
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=    alternative: the same JSON base64-encoded (use if Vercel mangles the line breaks in private_key)
# GOOGLE_CALENDAR_SYNC=off            optional kill switch
