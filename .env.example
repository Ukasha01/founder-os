# Founder OS environment template. Copy to .env.local and fill in. NEVER commit .env.local.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and must never be exposed to the browser.
# Phases show when each variable is first needed; leave later ones empty until then.
# An empty value means the feature reports "not configured". It will not pretend to work.

# --- Phase 1 -----------------------------------------------------------------
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The public ("anon") key. Safe in the browser only because Row Level Security is on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the app is served; used for sign-in redirects. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google sign-in: client ID/secret are configured in the Supabase dashboard (Auth > Providers),
# not here.

# --- Phase 4 (AI assistant) --------------------------------------------------
# Google AI Studio API key. SERVER ONLY.
GEMINI_API_KEY=
# Kept configurable because model names and free-tier availability change.
GEMINI_MODEL=
# Your own daily cap on assistant requests, so you hit your limit before Google's.
AI_DAILY_REQUEST_CAP=100

# --- Phase 5 (reliability) ---------------------------------------------------
# Bypasses Row Level Security. SERVER ONLY. Used by the reminder scheduler and backup job.
SUPABASE_SERVICE_ROLE_KEY=
# Random string (e.g. `openssl rand -hex 32`) protecting /api/cron/* endpoints.
CRON_SECRET=
# Web Push. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email reminders: provider not chosen yet.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# One-way Google Calendar export. Separate Google Cloud OAuth client with the Calendar scope.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Encrypts stored Google refresh tokens: `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=

# --- Voice assistant (Urdu) --------------------------------------------------
# Speech -> text uses GEMINI_API_KEY (above). Override the model if needed.
GEMINI_STT_MODEL=
# Text -> speech. "elevenlabs", "gemini" or "off". Empty = ElevenLabs if its key is set, else Gemini.
TTS_PROVIDER=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
# Optional, better quality, limited free characters per month. https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Fast free brain (recommended: Gemini's free allowance is small and slow) ----
# Free key, no card: https://console.groq.com . Also used for Whisper speech-to-text as a fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional second fast provider. Free key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
# Which brain goes first: "groq", "cerebras" or "gemini". Empty = fast providers first, Gemini as the fallback.
LLM_PROVIDER=
# Which speech-to-text goes first: "gemini" (default) or "groq".
STT_PROVIDER=

# Urdu turns use Gemini first (better Urdu), English turns use the fast provider. Set LLM_URDU_PROVIDER=fast to disable that,
# or LLM_PROVIDER=gemini|groq|cerebras to force one provider for everything.
# LLM_URDU_PROVIDER=
